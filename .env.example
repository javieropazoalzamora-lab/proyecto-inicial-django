# Copia este archivo como ".env" (en la misma carpeta que manage.py) y completa los valores.
# El archivo .env NO se sube a Git (está en .gitignore).

# --- Correo (activación de cuenta y recuperación de clave) ---
# Ejemplo con Gmail: requiere verificación en 2 pasos y una "contraseña de aplicación"
# (https://myaccount.google.com/apppasswords). NO uses tu contraseña normal.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=tucuenta@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
# Opcional: nombre y correo que verá quien recibe
# DEFAULT_FROM_EMAIL=VitaSansano <tucuenta@gmail.com>

# Si dejas EMAIL_HOST vacío o lo comentas, los correos se muestran en la terminal (modo desarrollo).

# --- IA (opcional) ---
# GEMINI_API_KEY=tu_clave
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Producción (opcional) ---
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=una_clave_larga_y_aleatoria
# DJANGO_ALLOWED_HOSTS=midominio.cl
